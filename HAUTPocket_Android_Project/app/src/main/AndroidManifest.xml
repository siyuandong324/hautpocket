<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅声明必要权限，严禁包含任何第三方统计/定位/通讯录权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="工大口袋 (开源版)"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 状态栏通知自动记账服务（需用户手动开启通知使用权，仅过滤校园卡消费通知） -->
        <service
            android:name=".data.importer.CampusCardNotificationListener"
            android:exported="true"
            android:label="工大口袋·一卡通消费通知自动记账"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 专注番茄钟前台服务 -->
        <service
            android:name=".service.PomodoroForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 桌面小组件 1：今日课表微件 -->
        <receiver
            android:name=".widget.TodayScheduleWidgetReceiver"
            android:exported="true"
            android:label="工大口袋·今日课表">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_schedule" />
        </receiver>

        <!-- 桌面小组件 2：寝室电费余量微件 -->
        <receiver
            android:name=".widget.DormElectricityWidgetReceiver"
            android:exported="true"
            android:label="工大口袋·寝室电费">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dorm_electricity" />
        </receiver>

        <!-- 桌面小组件 3：一卡通消费微件 -->
        <receiver
            android:name=".widget.CampusCardWidgetReceiver"
            android:exported="true"
            android:label="工大口袋·一卡通今日消费">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_campus_card" />
        </receiver>
    </application>
</manifest>
